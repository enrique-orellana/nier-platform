# OpenShorts environment variables
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
# Optional profile overlays:
#   .env.local
#   .env.devel
#   .env.quality
#
# Notes:
# - Most AI provider keys are entered in the dashboard Settings screen and
#   stored in the browser, not in this file.
# - The deploy helpers load `.env` automatically and can overlay one of the
#   profile files above when you pass `-Profile` / `--profile`.
# - The backend reads the variables below from the process environment.

# -----------------------------------------------------------------------------
# Core backend settings
# -----------------------------------------------------------------------------

# Limits how many jobs the backend processes at the same time.
# Default: 5
MAX_CONCURRENT_JOBS=5

# Local PostgreSQL settings used by the Kubernetes deployment helper.
OPENSHORTS_POSTGRES_DB=openshorts
OPENSHORTS_POSTGRES_USER=openshorts
OPENSHORTS_POSTGRES_PASSWORD=openshorts-local

# Google Gemini API key.
# Required if you run the backend or processing pipeline directly.
# In the dashboard, this key is usually set in Settings instead.
GEMINI_API_KEY=

# Hugging Face Access Token.
# Suppresses the unauthenticated download warning and increases rate limits
# for backend models (like Whisper and Transformers).
HF_TOKEN=

# Local AI defaults used by the native Ollama app on the Windows host.
# These point the backend and dashboard at the host service instead of a
# containerized Ollama instance.
# To use LM Studio instead, set AI_PROVIDER=lmstudio and point AI_BASE_URL
# to your LM Studio local server (e.g., http://localhost:1234)
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
AI_ANALYZE_MODEL=openai/gpt-4o-mini
AI_TRANSCRIPTION_PROVIDER=local
AI_TRANSCRIPTION_MODEL=openai/whisper-large-v3
AI_VISION_MODEL=qwen2.5vl:latest
AI_IMAGE_MODEL=

# Optional OpenAI Codex (ChatGPT subscription) provider.
# The dashboard connects through ChatGPT device authorization; no API key is required.
# Keep this file private. The default credential store is .openshorts/codex-auth.json.
OPENSHORTS_CODEX_AUTH_FILE=
CODEX_MODEL=gpt-5.4

# Native Ollama GPU settings for the Windows host app.
# The app may need a restart or a fresh Windows session after changing these.
OLLAMA_VULKAN=1
OLLAMA_LLM_LIBRARY=vulkan
GGML_VK_VISIBLE_DEVICES=1

# Optional cookie contents in Netscape format for yt-dlp downloads.
# Useful when YouTube blocks anonymous server-side requests.
YOUTUBE_COOKIES=

# -----------------------------------------------------------------------------
# S3 backup and gallery storage
# -----------------------------------------------------------------------------

# Optional. Only needed if you want to back up clips or publish gallery assets
# to Amazon S3.
# For the recovered MinIO deployment, the existing buckets are:
#   AWS_S3_BUCKET=model-zip
#   AWS_S3_PUBLIC_BUCKET=figures
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BUCKET=

# Optional. Set these when OpenShorts talks to MinIO or another S3-compatible
# store instead of AWS itself.
# Internal cluster endpoint example:
#   http://minio.minio-system.svc.cluster.local:9000
AWS_S3_ENDPOINT_URL=

# Public browser-facing base URL for gallery links and media URLs.
# Example:
#   http://minio.192.168.65.3.nip.io
AWS_S3_PUBLIC_URL_BASE=

# Optional public endpoint used only for presigned URLs.
# This can be the same as AWS_S3_PUBLIC_URL_BASE for MinIO setups.
AWS_S3_PUBLIC_ENDPOINT_URL=

# Force path-style S3 URLs. Keep this true for MinIO.
AWS_S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Frontend configuration
# -----------------------------------------------------------------------------

# Optional. Set this when the frontend needs to call an API on a different
# origin, such as in production.
# Example: https://api.openshorts.example
VITE_API_URL=

# Optional. Used by the dashboard for client-side encryption of stored keys.
# Leave blank to use the built-in fallback salt.
VITE_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Not used from .env
# -----------------------------------------------------------------------------
#
# These are configured in the dashboard UI and stored in browser localStorage:
# - FAL_KEY
# - ELEVENLABS_API_KEY
# - UPLOAD_POST_API_KEY
