# OpenShorts environment variables
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
# Optional profile overlays:
#   .env.local
#   .env.devel
#   .env.quality
#
# Notes:
# - Most AI provider keys are entered in the dashboard Settings screen and
#   stored in the browser, not in this file.
# - The deploy helpers load `.env` automatically and can overlay one of the
#   profile files above when you pass `-Profile` / `--profile`.
# - The backend reads the variables below from the process environment.

# -----------------------------------------------------------------------------
# Core backend settings
# -----------------------------------------------------------------------------

# Limits how many jobs the backend processes at the same time.
# Default: 5
MAX_CONCURRENT_JOBS=5

# Local PostgreSQL settings used by the Kubernetes deployment helper.
OPENSHORTS_POSTGRES_DB=openshorts
OPENSHORTS_POSTGRES_USER=openshorts
OPENSHORTS_POSTGRES_PASSWORD=openshorts-local

# Google Gemini API key.
# Required if you run the backend or processing pipeline directly.
# In the dashboard, this key is usually set in Settings instead.
GEMINI_API_KEY=

# Hugging Face Access Token.
# Suppresses the unauthenticated download warning and increases rate limits
# for backend models.
HF_TOKEN=

# Provider adapters are selected independently by capability. For fully local
# analysis, point transcription, event detection, and clip analysis at local
# services. Failures do not switch providers.
# For a local OpenAI-compatible chat server, use AI_PROVIDER=openai-compatible
# and a Docker-reachable URL such as http://host.docker.internal:11434/v1.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_ANALYZE_MODEL=openai/gpt-4o-mini
AI_CLIP_ANALYSIS_PROVIDER=chat-json

# Speech transcription service. Built-ins: openrouter-json and
# openai-compatible; installed plugin IDs are also valid. The provider is
# implicit only when chat analysis is OpenRouter; otherwise choose it explicitly.
# For a local service, set its base URL and model. Leave those blank to use the
# OpenRouter defaults when OpenRouter is also the chat provider.
# Its credential is separate from the chat credential. AI_API_KEY is shared only
# when AI_PROVIDER is also OpenRouter; otherwise set this key explicitly.
AI_TRANSCRIPTION_PROVIDER=
AI_TRANSCRIPTION_BASE_URL=
AI_TRANSCRIPTION_API_KEY=
AI_TRANSCRIPTION_MODEL=
AI_TRANSCRIPTION_LANGUAGE=auto
AI_TRANSCRIPTION_OPENROUTER_PROVIDER=

# Optional sound-event service. Built-ins: none, embedded, openshorts-events-v1;
# installed plugin IDs are also valid. The built-in HTTP endpoint accepts
# POST /v1/audio/events with an audio file and model.
AUDIO_EVENT_PROVIDER=none
AUDIO_EVENT_BASE_URL=
AUDIO_EVENT_MODEL=
AUDIO_EVENT_API_KEY=
AUDIO_EVENT_MIN_CONFIDENCE=0.35

# Inference jobs share cross-process slots, released before video rendering.
AI_ANALYSIS_CONCURRENCY=1
LOCAL_AUDIO_ANALYSIS_LOCK_DIR=/app/output/.openshorts/audio-analysis-locks

AI_VISION_MODEL=qwen2.5vl:latest
AI_IMAGE_MODEL=

# Optional OpenAI Codex (ChatGPT subscription) provider.
# The dashboard connects through ChatGPT device authorization; no API key is required.
# Keep this file private. The default credential store is .openshorts/codex-auth.json.
OPENSHORTS_CODEX_AUTH_FILE=
CODEX_MODEL=gpt-6-luna

# Complete-file clip analysis for the built-in chat-json adapter. With
# AI_PROVIDER=openai-codex and no OPENAI_API_KEY, this uses the connected Codex
# CLI. Setting OPENAI_API_KEY explicitly selects the public OpenAI Files API for
# this route; keep it server-only. AUTO selects the available Codex file route
# or the windowed chat route. If the selected route fails, the job fails; use
# legacy to select windowed analysis explicitly.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CLIP_ANALYSIS_MODE=auto
OPENAI_ANALYZE_MODEL=
OPENAI_FILE_ANALYSIS_MAX_TOKENS=100000

# Native Ollama GPU settings for the Windows host app.
# The app may need a restart or a fresh Windows session after changing these.
# Set model CPU/thread limits in the Ollama or other model service itself.
OLLAMA_VULKAN=1
OLLAMA_LLM_LIBRARY=vulkan
GGML_VK_VISIBLE_DEVICES=1

# Optional cookie contents in Netscape format for yt-dlp downloads.
# Useful when YouTube blocks anonymous server-side requests.
YOUTUBE_COOKIES=

# -----------------------------------------------------------------------------
# S3 backup and gallery storage
# -----------------------------------------------------------------------------

# OpenShorts uses the migrated SeaweedFS S3-compatible bucket for both generated media
# and source-object browsing when started with Docker Compose.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=openshorts-media
AWS_S3_PUBLIC_BUCKET=openshorts-media
AWS_S3_SOURCE_BUCKET=youtube-downloads

# AWS_S3_ENDPOINT_URL is used by the application and Docker Compose. The
# OPENSHORTS_* alias remains supported for older Docker environment files.
AWS_S3_ENDPOINT_URL=http://seaweedfs-s3.192.168.50.2.nip.io:32380
OPENSHORTS_S3_ENDPOINT_URL=http://seaweedfs-s3.192.168.50.2.nip.io:32380

# Large-object download tuning. Increase concurrency only when the S3 service and the
# network have enough capacity to handle the additional parallel requests.
MINIO_DOWNLOAD_MAX_CONCURRENCY=16
MINIO_DOWNLOAD_MULTIPART_THRESHOLD_MB=32
MINIO_DOWNLOAD_MULTIPART_CHUNKSIZE_MB=64

# Public browser-facing base URL for gallery links and media URLs.
AWS_S3_PUBLIC_URL_BASE=http://seaweedfs-s3.192.168.50.2.nip.io:32380

# Optional public endpoint used only for presigned URLs.
# This can be the same as AWS_S3_PUBLIC_URL_BASE for SeaweedFS setups.
OPENSHORTS_S3_PUBLIC_URL_BASE=http://seaweedfs-s3.192.168.50.2.nip.io:32380
OPENSHORTS_S3_PUBLIC_ENDPOINT_URL=http://seaweedfs-s3.192.168.50.2.nip.io:32380
AWS_S3_PUBLIC_ENDPOINT_URL=http://seaweedfs-s3.192.168.50.2.nip.io:32380

# Force path-style S3 URLs. Keep this true for SeaweedFS.
AWS_S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Frontend configuration
# -----------------------------------------------------------------------------

# Optional. Set this when the frontend needs to call an API on a different
# origin, such as in production.
# Example: https://api.openshorts.example
VITE_API_URL=

# Optional. Used by the dashboard for client-side encryption of stored keys.
# Leave blank to use the built-in fallback salt.
VITE_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Not used from .env
# -----------------------------------------------------------------------------
#
# These are configured in the dashboard UI and stored in browser localStorage:
# - FAL_KEY
# - ELEVENLABS_API_KEY
# - UPLOAD_POST_API_KEY
