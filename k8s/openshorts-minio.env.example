# OpenShorts S3 settings for the recovered MinIO deployment

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3

# Dedicated OpenShorts bucket
AWS_S3_BUCKET=openshorts-media
AWS_S3_PUBLIC_BUCKET=openshorts-media

# In-cluster S3 endpoint used by the backend pods
AWS_S3_ENDPOINT_URL=http://minio.minio-system.svc.cluster.local:9000

# Browser-facing base URL used when OpenShorts builds public gallery links
AWS_S3_PUBLIC_URL_BASE=http://minio.openshorts.127.0.0.1.nip.io

# Endpoint used when the backend generates presigned URLs
AWS_S3_PUBLIC_ENDPOINT_URL=http://minio.openshorts.127.0.0.1.nip.io

# Keep this enabled for MinIO
AWS_S3_FORCE_PATH_STYLE=true
