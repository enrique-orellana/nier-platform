# Non-secret OpenShorts runtime settings for Kubernetes

MAX_CONCURRENT_JOBS=5
MAX_MINIO_SOURCE_SIZE_MB=16384
AWS_REGION=eu-west-3
OPENSHORTS_GPU_RUNTIME=cuda
OPENSHORTS_DEVICE=auto
OPENSHORTS_NODE_NAME=hinzky
OPENSHORTS_STORAGE_PATH=/var/lib/openshorts/workdir
RENDER_ACCELERATOR=auto
RENDER_HARDWARE_ACCELERATION=if-possible

# AI provider configuration
# Use "gemini" for Google Gemini, "openrouter" for OpenRouter, or "lmstudio" for local models.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_QUALITY_PRESET=balanced

# Optional OpenAI Codex (ChatGPT subscription) provider.
# Persist the installation-scoped credential file on the OpenShorts PVC.
OPENSHORTS_CODEX_AUTH_FILE=/app/output/.openshorts/codex-auth.json
CODEX_MODEL=gpt-5.4

# Backend model defaults. These are also mirrored to the frontend as Vite env vars.
AI_MODEL=openai/gpt-4o-mini
AI_ANALYZE_MODEL=openai/gpt-4o-mini
AI_VISION_MODEL=openai/gpt-4o-mini
AI_IMAGE_MODEL=
AI_TRANSCRIPTION_MODEL=openai/whisper-large-v3

# Frontend build/runtime variables used by the dashboard container.
VITE_AI_PROVIDER=openrouter
VITE_AI_BASE_URL=https://openrouter.ai/api/v1
VITE_AI_QUALITY_PRESET=balanced
VITE_AI_MODEL=openai/gpt-4o-mini
VITE_AI_ANALYZE_MODEL=openai/gpt-4o-mini
VITE_AI_VISION_MODEL=openai/gpt-4o-mini
VITE_AI_IMAGE_MODEL=
VITE_AI_TRANSCRIPTION_MODEL=openai/whisper-large-v3

# Dedicated OpenShorts bucket
AWS_S3_BUCKET=openshorts-media
AWS_S3_PUBLIC_BUCKET=openshorts-media

# In-cluster MinIO endpoint used by the backend
AWS_S3_ENDPOINT_URL=http://minio-standalone.minio-system.svc.cluster.local:9000

# Browser-facing MinIO ingress used for signed gallery links
AWS_S3_PUBLIC_URL_BASE=http://minio.192.168.1.189.nip.io:32280
AWS_S3_PUBLIC_ENDPOINT_URL=http://minio.192.168.1.189.nip.io:32280

# MinIO compatibility
AWS_S3_FORCE_PATH_STYLE=true
MINIO_VIDEO_CACHE_CONTROL=public, max-age=31536000, immutable

# Internal renderer URL
RENDER_SERVICE_URL=http://openshorts-renderer.openshorts.svc.cluster.local:3100
TRANSLATION_SERVICE_URL=http://openshorts-translation.openshorts.svc.cluster.local:3200
