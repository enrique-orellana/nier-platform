# Non-secret OpenShorts runtime settings for Kubernetes

MAX_CONCURRENT_JOBS=5
AWS_REGION=eu-west-3

# AI provider configuration
# Use "gemini" for Google Gemini, or "ollama" for local models.
AI_PROVIDER=ollama
AI_BASE_URL=http://host.docker.internal:11434
AI_QUALITY_PRESET=balanced

# Backend model defaults. These are also mirrored to the frontend as Vite env vars.
AI_MODEL=qwen3:latest
AI_ANALYZE_MODEL=auto
AI_VISION_MODEL=qwen2.5vl:latest
AI_IMAGE_MODEL=auto

# Frontend build/runtime variables used by the dashboard container.
VITE_AI_PROVIDER=ollama
VITE_AI_BASE_URL=http://host.docker.internal:11434
VITE_AI_QUALITY_PRESET=balanced
VITE_AI_MODEL=qwen3:latest
VITE_AI_ANALYZE_MODEL=auto
VITE_AI_VISION_MODEL=qwen2.5vl:latest
VITE_AI_IMAGE_MODEL=auto

# Dedicated OpenShorts bucket
AWS_S3_BUCKET=openshorts-media
AWS_S3_PUBLIC_BUCKET=openshorts-media

# In-cluster MinIO endpoint used by the backend
AWS_S3_ENDPOINT_URL=http://minio.minio-system.svc.cluster.local:9000

# Browser-facing MinIO ingress used for signed gallery links
AWS_S3_PUBLIC_URL_BASE=http://minio.127.0.0.1.nip.io
AWS_S3_PUBLIC_ENDPOINT_URL=http://minio.127.0.0.1.nip.io

# MinIO compatibility
AWS_S3_FORCE_PATH_STYLE=true

# Internal renderer URL
RENDER_SERVICE_URL=http://openshorts-renderer.openshorts.svc.cluster.local:3100
